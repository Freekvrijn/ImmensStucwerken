Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:_lib|data|themas)(?:/|$) - [F,L]
  RewriteRule ^(atelier|galerie|werkplaats)(?:/.*)?$ - [R=404,L]
  RewriteRule ^blauwdruk/?$ index.php [L,QSA]
  RewriteRule ^offerte/?$ offerte.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ eigen-pagina.php?p=$1 [L,QSA]
</IfModule>
ErrorDocument 404 /404.php
